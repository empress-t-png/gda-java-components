package programmingtheiot.data;

import programmingtheiot.common.ConfigConst;

/**
 * ActuatorData represents a command sent to an actuator.
 */
public class ActuatorData extends BaseIotData
{
    private int command = ConfigConst.OFF_COMMAND;
    private boolean isResponse = false;
    private float value = 0.0f;
    private String stateData = "";   // ✅ new field to hold state info

    public ActuatorData() { super(); }

    public int getCommand() { return this.command; }
    public void setCommand(int command) { this.command = command; }

    public boolean isResponseFlagEnabled() { return this.isResponse; }
    public void setAsResponse() { this.isResponse = true; }

    public float getValue() { return this.value; }
    public void setValue(float value) { this.value = value; }

    /**
     * Set state information for this actuator.
     * @param state A string describing the actuator state
     */
    public void setStateData(String state)
    {
        this.stateData = state;
    }

    /**
     * Get the current state information.
     * @return The state string
     */
    public String getStateData()
    {
        return this.stateData;
    }

    @Override
    public void handleUpdateData(BaseIotData data)
    {
        if (data instanceof ActuatorData) {
            ActuatorData ad = (ActuatorData) data;
            this.command = ad.getCommand();
            this.value = ad.getValue();
            this.isResponse = ad.isResponseFlagEnabled();
            this.stateData = ad.getStateData();
        }
    }

    @Override
    public String toString()
    {
        return "ActuatorData [name=" + getName() + ", command=" + command +
               ", value=" + value + ", isResponse=" + isResponse +
               ", stateData=" + stateData + "]";
    }
    /**
     * Update this ActuatorData with values from another ActuatorData.
     * 
     * @param actuatorData The source ActuatorData
     */
    public void updateData(ActuatorData actuatorData)
    {
        if (actuatorData != null) {
            this.setCommand(actuatorData.getCommand());
            this.setValue(actuatorData.getValue());
            this.setStateData(actuatorData.getStateData());
            this.setResponseData(actuatorData.getResponseData());
        }
    }
}

    /**
     * Update this ActuatorData with values from another ActuatorData.
     * 
     * @param actuatorData The source ActuatorData
     */
    public void updateData(ActuatorData actuatorData)
    {
        if (actuatorData != null) {
            this.setCommand(actuatorData.getCommand());
            this.setValue(actuatorData.getValue());
            this.setStateData(actuatorData.getStateData());
            this.setResponseData(actuatorData.getResponseData());
        }
    }
